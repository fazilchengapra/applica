# notification_service environment.
# Copy to .env and fill in. Every value here is required unless noted.

PORT=8000
NODE_ENV=development

# The service's own Postgres. This is where the notification inbox lives.
DATABASE_URL=postgresql://not_user:not_pass@notification_postgres:5432/not_service_db?schema=public

# Must match kong/.env, user_service and ai_service. Kong's header_injector
# plugin stamps it on every forwarded request; the user-facing routes compare it
# before trusting X-User-Id, so traffic that skipped the gateway is refused.
GATEWAY_INTERNAL_SECRET=change-me

# user_service, reached through Kong. Service-to-service calls only.
USER_SERVICE_URL=http://kong:8000
USER_SERVICE_TIMEOUT=5

# redis (queues + realtime fan-out)
REDIS_HOST=redis
REDIS_PORT=6379

# gmail smtp
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15550000000

# link templates point at
FRONTEND_URL=http://localhost:3000

# LOG_LEVEL=debug
